<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loot Table — Sklep dla graczy planszówkowych</title>
<meta name="description" content="Kości, miniaturki, pionki, teren i organizery do gier planszowych. Wyselekcjonowane, testowane przy stole.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #131110;
    --bg-1: #1c1712;
    --panel: #1e1914;
    --panel-2: #241e17;
    --line: #35291c;
    --gold: #e2a53a;
    --gold-2: #f3c469;
    --ember: #c24a2a;
    --ember-2: #e06a3f;
    --parchment: #f1e6cf;
    --ink: #241c12;
    --text: #ede2cc;
    --text-muted: #bcab8b;
    --emerald: #3f7d5c;
    --slate: #6c7580;
    --radius: 14px;
    --wrap: 1180px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  img,svg{display:block; max-width:100%;}
  a{color:inherit;}
  .wrap{max-width:var(--wrap); margin:0 auto; padding:0 28px;}
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    font-weight:600;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--gold);
    display:inline-flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{
    content:"";
    width:18px; height:1px;
    background:var(--gold);
    display:inline-block;
  }
  .section-title{
    font-family:'Oswald', sans-serif;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.02em;
    font-size:clamp(28px, 3.6vw, 40px);
    color:var(--text);
    margin:10px 0 0;
  }
  .section-title em{color:var(--gold); font-style:normal;}
  section{padding:88px 0;}

  :focus-visible{outline:2px solid var(--gold-2); outline-offset:3px;}

  /* ---------- seal mark ---------- */
  .seal{
    width:40px; height:40px; flex-shrink:0;
  }

  /* ---------- header ---------- */
  header.site{
    position:sticky; top:0; z-index:50;
    background:rgba(19,17,16,.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  header.site .bar{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 0;
  }
  .brand{display:flex; align-items:center; gap:12px; text-decoration:none;}
  .brand-word{
    font-family:'Cinzel', serif;
    font-weight:900;
    font-size:20px;
    letter-spacing:.06em;
    color:var(--gold-2);
    text-transform:uppercase;
  }
  nav.links{display:flex; gap:32px; list-style:none; margin:0; padding:0;}
  nav.links a{
    font-family:'Oswald', sans-serif;
    font-size:14px;
    font-weight:600;
    letter-spacing:.04em;
    text-transform:uppercase;
    text-decoration:none;
    color:var(--text-muted);
    transition:color .15s ease;
  }
  nav.links a:hover{color:var(--gold-2);}
  .header-actions{display:flex; align-items:center; gap:18px;}
  .icon-btn{
    background:none; border:1px solid var(--line); color:var(--text);
    width:38px; height:38px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:border-color .15s ease, color .15s ease;
  }
  .icon-btn:hover{border-color:var(--gold); color:var(--gold-2);}
  .nav-toggle{display:none; background:none; border:none; color:var(--text); cursor:pointer;}

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    overflow:hidden;
    padding:76px 0 0;
    background:
      radial-gradient(ellipse 900px 500px at 78% 10%, rgba(226,165,58,.16), transparent 60%),
      radial-gradient(ellipse 700px 500px at 10% 90%, rgba(194,74,42,.10), transparent 60%),
      repeating-linear-gradient(180deg, #171310 0px, #171310 2px, #14100d 2px, #14100d 4px),
      var(--bg);
  }
  .hero-grid{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:40px;
    align-items:center;
  }
  .hero-copy h1{
    font-family:'Cinzel', serif;
    font-weight:900;
    font-size:clamp(38px, 5.4vw, 62px);
    line-height:1.06;
    margin:18px 0 22px;
    color:var(--parchment);
    text-shadow:0 2px 0 rgba(0,0,0,.5);
  }
  .hero-copy h1 span{
    background:linear-gradient(180deg, var(--gold-2), var(--gold) 60%, var(--ember-2));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .hero-copy p{
    color:var(--text-muted);
    font-size:17.5px;
    max-width:480px;
    margin:0 0 32px;
  }
  .hero-ctas{display:flex; gap:16px; flex-wrap:wrap; margin-bottom:34px;}
  .btn{
    font-family:'Oswald', sans-serif;
    font-weight:700;
    font-size:14.5px;
    letter-spacing:.05em;
    text-transform:uppercase;
    text-decoration:none;
    padding:15px 28px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    gap:10px;
    cursor:pointer;
    border:1px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{
    background:linear-gradient(180deg, var(--gold-2), var(--gold));
    color:#241a0c;
    box-shadow:0 10px 24px -8px rgba(226,165,58,.55);
  }
  .btn-primary:hover{box-shadow:0 14px 28px -8px rgba(226,165,58,.7);}
  .btn-ghost{
    background:transparent;
    border-color:var(--line);
    color:var(--text);
  }
  .btn-ghost:hover{border-color:var(--gold); color:var(--gold-2);}

  .rating-chip{
    display:inline-flex; align-items:center; gap:10px;
    font-family:'JetBrains Mono', monospace;
    font-size:13px;
    color:var(--text-muted);
  }
  .rating-chip strong{color:var(--gold-2); font-size:14px;}
  .stars{color:var(--gold-2); letter-spacing:2px;}

  /* hero flatlay illustration */
  .flatlay{
    position:relative;
    aspect-ratio:1/1;
    max-width:480px;
    margin:0 auto;
  }
  .flatlay .table-glow{
    position:absolute; inset:6%;
    border-radius:50%;
    background:radial-gradient(circle at 50% 45%, rgba(226,165,58,.14), transparent 65%);
  }
  .flatlay .piece{
    position:absolute;
    filter:drop-shadow(0 10px 16px rgba(0,0,0,.5));
  }
  .flatlay .piece.p1{ width:34%; top:4%; left:8%; transform:rotate(-14deg); }
  .flatlay .piece.p2{ width:30%; top:8%; right:4%; transform:rotate(10deg); }
  .flatlay .piece.p3{ width:26%; bottom:6%; left:2%; transform:rotate(6deg); }
  .flatlay .piece.p4{ width:40%; bottom:0%; right:8%; transform:rotate(-6deg); }
  .flatlay .piece.p5{ width:22%; top:38%; left:38%; transform:rotate(18deg); }

  /* arch divider */
  .arch-divider{
    position:relative;
    height:70px;
    margin-top:70px;
  }
  .arch-divider svg{width:100%; height:100%;}

  /* ---------- trust bar ---------- */
  .trust-bar{
    padding:34px 0;
    border-bottom:1px solid var(--line);
  }
  .trust-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:20px;
  }
  .trust-item{
    display:flex; align-items:center; gap:12px;
    justify-content:center;
    font-family:'Oswald', sans-serif;
    font-size:13.5px;
    font-weight:600;
    letter-spacing:.03em;
    text-transform:uppercase;
    color:var(--text-muted);
    text-align:center;
  }
  .trust-item svg{color:var(--gold); flex-shrink:0;}

  /* ---------- categories ---------- */
  .cat-head{display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:44px; flex-wrap:wrap;}
  .cat-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:22px;
  }
  .cat-card{
    background:linear-gradient(180deg, var(--panel-2), var(--panel));
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:30px 26px;
    text-decoration:none;
    display:flex;
    flex-direction:column;
    gap:18px;
    transition:border-color .18s ease, transform .18s ease;
  }
  .cat-card:hover{border-color:var(--gold); transform:translateY(-4px);}
  .cat-badge{
    width:56px; height:56px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #2a2119, #17130f);
    border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    color:var(--gold-2);
  }
  .cat-card h3{
    font-family:'Oswald', sans-serif;
    text-transform:uppercase;
    font-size:18px;
    letter-spacing:.02em;
    margin:0;
    color:var(--text);
  }
  .cat-card p{margin:0; color:var(--text-muted); font-size:14.5px;}
  .cat-card .go{
    margin-top:auto;
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    color:var(--gold);
    letter-spacing:.05em;
  }

  /* ---------- bestsellers ---------- */
  .prod-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:22px;
  }
  .prod-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
    overflow:hidden;
    display:flex; flex-direction:column;
    transition:border-color .18s ease, transform .18s ease;
  }
  .prod-card:hover{border-color:var(--gold); transform:translateY(-4px);}
  .prod-media{
    aspect-ratio:4/3;
    background:
      radial-gradient(circle at 30% 20%, rgba(226,165,58,.14), transparent 55%),
      var(--panel-2);
    display:flex; align-items:center; justify-content:center;
    position:relative;
    border-bottom:1px solid var(--line);
  }
  .prod-media svg{width:46%; color:var(--gold-2);}
  .prod-tag{
    position:absolute; top:12px; left:12px;
    background:var(--ember);
    color:var(--parchment);
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px; font-weight:600; letter-spacing:.05em;
    text-transform:uppercase;
    padding:5px 9px;
    border-radius:999px;
  }
  .prod-body{padding:18px 20px 22px; display:flex; flex-direction:column; gap:6px; flex:1;}
  .prod-body h4{
    font-family:'Oswald', sans-serif;
    font-size:15.5px;
    text-transform:uppercase;
    letter-spacing:.01em;
    margin:0;
    color:var(--text);
  }
  .prod-body .meta{color:var(--text-muted); font-size:13px; margin:0 0 8px;}
  .prod-foot{display:flex; align-items:center; justify-content:space-between; margin-top:auto;}
  .price{
    font-family:'JetBrains Mono', monospace;
    font-weight:600;
    font-size:16px;
    color:var(--gold-2);
  }
  .add-btn{
    background:none; border:1px solid var(--line); color:var(--text);
    font-family:'Oswald', sans-serif; font-size:12px; font-weight:600;
    letter-spacing:.04em; text-transform:uppercase;
    padding:8px 14px; border-radius:999px; cursor:pointer;
    transition:border-color .15s ease, color .15s ease;
  }
  .add-btn:hover{border-color:var(--gold); color:var(--gold-2);}

  /* ---------- benefits ---------- */
  .benefits{
    background:var(--bg-1);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .benefit-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:40px;
  }
  .benefit{text-align:center; padding:0 10px;}
  .benefit .num{
    font-family:'Cinzel', serif;
    font-weight:700;
    font-size:13px;
    letter-spacing:.2em;
    color:var(--ember-2);
    text-transform:uppercase;
  }
  .benefit h3{
    font-family:'Oswald', sans-serif;
    text-transform:uppercase;
    font-size:19px;
    letter-spacing:.03em;
    margin:10px 0 10px;
    color:var(--text);
  }
  .benefit p{color:var(--text-muted); font-size:14.5px; margin:0; max-width:280px; margin-inline:auto;}
  .benefit-rule{width:44px; height:2px; background:var(--gold); margin:0 auto 18px; opacity:.7;}

  /* ---------- quote ---------- */
  .quote-wrap{display:flex; justify-content:center;}
  .quote-card{
    position:relative;
    max-width:720px;
    background:var(--parchment);
    color:var(--ink);
    border:1px solid #d8c69c;
    border-radius:6px;
    padding:46px 56px;
    text-align:center;
    box-shadow:0 24px 50px -20px rgba(0,0,0,.6);
  }
  .quote-card::before, .quote-card::after{
    content:"";
    position:absolute;
    width:26px; height:26px;
    background:var(--bg);
    border-radius:50%;
  }
  .quote-mark{
    font-family:'Cinzel', serif;
    font-size:52px;
    color:var(--ember);
    line-height:1;
    display:block;
    margin-bottom:6px;
  }
  .quote-card p.text{
    font-family:'Oswald', sans-serif;
    font-size:clamp(17px, 2.1vw, 21px);
    line-height:1.5;
    margin:0 0 18px;
    text-transform:none;
    letter-spacing:.01em;
  }
  .quote-card .who{
    font-family:'JetBrains Mono', monospace;
    font-size:13px;
    color:#6b5a3a;
  }

  /* ---------- cta band ---------- */
  .cta-band{
    background:linear-gradient(120deg, var(--gold), var(--ember-2));
    padding:56px 0;
  }
  .cta-band .inner{
    display:flex; align-items:center; justify-content:space-between; gap:30px; flex-wrap:wrap;
  }
  .cta-band h2{
    font-family:'Cinzel', serif;
    font-weight:900;
    font-size:clamp(24px, 3vw, 32px);
    color:#241a0c;
    margin:0 0 6px;
  }
  .cta-band p{margin:0; color:#3a2a12; font-size:15px;}
  .cta-form{display:flex; gap:10px; flex-wrap:wrap;}
  .cta-form input{
    background:#f6ead0;
    border:1px solid #b98a3a;
    border-radius:999px;
    padding:13px 18px;
    font-family:'Inter', sans-serif;
    font-size:14px;
    color:#241a0c;
    min-width:240px;
  }
  .cta-form input::placeholder{color:#7a6740;}
  .cta-form button{
    background:#241a0c;
    color:var(--gold-2);
    border:none;
    border-radius:999px;
    padding:13px 24px;
    font-family:'Oswald', sans-serif;
    font-weight:700;
    font-size:13.5px;
    letter-spacing:.05em;
    text-transform:uppercase;
    cursor:pointer;
  }
  .form-note{
    width:100%;
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:#3a2a12;
    margin-top:6px;
    min-height:16px;
  }

  /* ---------- footer ---------- */
  footer{padding:64px 0 32px; background:var(--bg);}
  .footer-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr 1fr;
    gap:40px;
    padding-bottom:40px;
    border-bottom:1px solid var(--line);
  }
  .footer-brand p{color:var(--text-muted); font-size:14px; max-width:280px; margin:14px 0 0;}
  .footer-col h5{
    font-family:'Oswald', sans-serif;
    text-transform:uppercase;
    font-size:13px;
    letter-spacing:.06em;
    color:var(--gold);
    margin:0 0 16px;
  }
  .footer-col ul{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;}
  .footer-col a{color:var(--text-muted); text-decoration:none; font-size:14px; transition:color .15s ease;}
  .footer-col a:hover{color:var(--gold-2);}
  .footer-bottom{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:26px; flex-wrap:wrap; gap:12px;
  }
  .footer-bottom p{margin:0; color:var(--text-muted); font-size:12.5px; font-family:'JetBrains Mono', monospace;}
  .socials{display:flex; gap:12px;}

  /* ---------- responsive ---------- */
  @media (max-width: 980px){
    nav.links{display:none;}
    .nav-toggle{display:flex; align-items:center;}
    .hero-grid{grid-template-columns:1fr;}
    .flatlay{margin-top:20px;}
    .trust-grid{grid-template-columns:repeat(2,1fr);}
    .cat-grid{grid-template-columns:repeat(2,1fr);}
    .prod-grid{grid-template-columns:repeat(2,1fr);}
    .benefit-grid{grid-template-columns:1fr; gap:36px;}
    .footer-grid{grid-template-columns:1fr 1fr; row-gap:32px;}
  }
  @media (max-width: 620px){
    section{padding:60px 0;}
    .cat-grid{grid-template-columns:1fr;}
    .prod-grid{grid-template-columns:1fr;}
    .quote-card{padding:36px 24px;}
    .cta-band .inner{flex-direction:column; align-items:flex-start;}
    .footer-grid{grid-template-columns:1fr;}
    .trust-grid{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

<header class="site">
  <div class="wrap bar">
    <a class="brand" href="#top">
      <svg class="seal" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="#1c1712" stroke="#e2a53a" stroke-width="1.4"/>
        <circle cx="20" cy="20" r="14.5" fill="none" stroke="#c24a2a" stroke-width="1"/>
        <path d="M20 10 L27 14.5 V25.5 L20 30 L13 25.5 V14.5 Z" fill="none" stroke="#f3c469" stroke-width="1.3"/>
        <path d="M20 10 V30 M13 14.5 L27 25.5 M27 14.5 L13 25.5" stroke="#f3c469" stroke-width=".7" opacity=".7"/>
      </svg>
      <span class="brand-word">Loot Table</span>
    </a>
    <ul class="links">
      <li><a href="#kategorie">Kości</a></li>
      <li><a href="#kategorie">Miniaturki</a></li>
      <li><a href="#kategorie">Teren</a></li>
      <li><a href="#bestsellery">Bestsellery</a></li>
      <li><a href="#kategorie">Wszystkie produkty</a></li>
    </ul>
    <div class="header-actions">
      <button class="icon-btn" aria-label="Szukaj">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <button class="icon-btn" aria-label="Koszyk, 0 produktów">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
      </button>
      <button class="nav-toggle icon-btn" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<main id="top">

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Sklep prowadzony przez graczy</span>
        <h1>Każda wielka kampania<br>zasługuje na <span>dobry sprzęt.</span></h1>
        <p>Wyselekcjonowane kości, miniaturki, pionki i teren dla graczy, którym zależy na tym, co ląduje na stole. Testujemy każdy produkt, zanim trafi do sklepu.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#kategorie">Przeglądaj łup
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="#bestsellery">Nowości</a>
        </div>
        <div class="rating-chip">
          <span class="stars">★★★★★</span>
          <strong>4.9 / 5</strong> — od 2 300+ graczy
        </div>
      </div>

      <div class="flatlay" aria-hidden="true">
        <div class="table-glow"></div>

        <svg class="piece p1" viewBox="0 0 100 100"><!-- hex tile forest -->
          <polygon points="50,4 93,27 93,73 50,96 7,73 7,27" fill="#233d2c" stroke="#3f7d5c" stroke-width="2"/>
          <path d="M30 60 Q50 30 70 60" fill="none" stroke="#3f7d5c" stroke-width="2.5" opacity=".8"/>
          <circle cx="50" cy="48" r="6" fill="#3f7d5c"/>
        </svg>

        <svg class="piece p2" viewBox="0 0 100 100"><!-- d20 -->
          <polygon points="50,4 93,27 93,73 50,96 7,73 7,27" fill="#241e17" stroke="#e2a53a" stroke-width="2.4"/>
          <path d="M50 4V96M7 27L93 73M93 27L7 73" stroke="#e2a53a" stroke-width="1" opacity=".55"/>
          <text x="50" y="57" text-anchor="middle" font-family="Oswald, sans-serif" font-weight="700" font-size="26" fill="#f3c469">20</text>
        </svg>

        <svg class="piece p3" viewBox="0 0 100 100"><!-- meeple -->
          <path d="M50 8 C41 8 35 15 35 23 C35 29 38 33 42 35 L28 58 C25 65 28 72 35 74 L39 92 L61 92 L65 74 C72 72 75 65 72 58 L58 35 C62 33 65 29 65 23 C65 15 59 8 50 8 Z" fill="#c24a2a"/>
        </svg>

        <svg class="piece p4" viewBox="0 0 120 90"><!-- card sleeves box -->
          <rect x="6" y="18" width="70" height="52" rx="6" fill="#241e17" stroke="#e2a53a" stroke-width="2"/>
          <rect x="18" y="6" width="70" height="52" rx="6" fill="#2c2418" stroke="#f3c469" stroke-width="2"/>
          <rect x="30" y="16" width="46" height="32" rx="3" fill="none" stroke="#e2a53a" stroke-width="1.4" opacity=".7"/>
        </svg>

        <svg class="piece p5" viewBox="0 0 100 100"><!-- d6 -->
          <rect x="10" y="10" width="80" height="80" rx="14" fill="#2c2418" stroke="#e2a53a" stroke-width="2.4"/>
          <circle cx="30" cy="30" r="6.5" fill="#f3c469"/>
          <circle cx="70" cy="30" r="6.5" fill="#f3c469"/>
          <circle cx="50" cy="50" r="6.5" fill="#f3c469"/>
          <circle cx="30" cy="70" r="6.5" fill="#f3c469"/>
          <circle cx="70" cy="70" r="6.5" fill="#f3c469"/>
        </svg>
      </div>
    </div>

    <div class="arch-divider" aria-hidden="true">
      <svg viewBox="0 0 1200 70" preserveAspectRatio="none">
        <path d="M0,0 L0,70 Q600,-30 1200,70 L1200,0 Z" fill="#131110"/>
      </svg>
    </div>
  </section>

  <section class="trust-bar">
    <div class="wrap trust-grid">
      <div class="trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="7" width="15" height="10" rx="1.5"/><path d="M16 10h3l3 3v4h-6"/><circle cx="6" cy="19" r="1.6"/><circle cx="18.5" cy="19" r="1.6"/></svg>
        Wysyłka w 24h
      </div>
      <div class="trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
        Bezpieczne płatności
      </div>
      <div class="trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/></svg>
        Prowadzony przez graczy
      </div>
      <div class="trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.9 6 6.6.6-5 4.4 1.5 6.5L12 16l-5.9 3.5L7.6 13l-5-4.4 6.6-.6L12 2z"/></svg>
        4.9★ od 2 300+ graczy
      </div>
    </div>
  </section>

  <section id="kategorie">
    <div class="wrap">
      <div class="cat-head">
        <div>
          <span class="eyebrow">Przeglądaj wg działu</span>
          <h2 class="section-title">Wszystko na twój <em>stół</em></h2>
        </div>
      </div>

      <div class="cat-grid">
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12,2 21,7.5 21,16.5 12,22 3,16.5 3,7.5"/></svg>
          </div>
          <h3>Kości i RNG</h3>
          <p>Szklane, metalowe i żywiczne zestawy — od podstawówki po kolekcjonerskie edycje.</p>
          <span class="go">Zobacz dział →</span>
        </a>
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="6" r="2.6"/><path d="M8 21l1.5-8h5L16 21M6 9l6-2 6 2"/></svg>
          </div>
          <h3>Miniaturki</h3>
          <p>Niepomalowane i malowane figurki bohaterów, potworów i najemników.</p>
          <span class="go">Zobacz dział →</span>
        </a>
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-3 0-5 2-5 4.5 0 1.6 1 2.7 2 3.4L6 18c-.6 1.6.4 3 2 3.2h8c1.6-.2 2.6-1.6 2-3.2l-3-7.1c1-.7 2-1.8 2-3.4C17 5 15 3 12 3z"/></svg>
          </div>
          <h3>Pionki i żetony</h3>
          <p>Drewniane meeple, akrylowe znaczniki i customowe zestawy graczy.</p>
          <span class="go">Zobacz dział →</span>
        </a>
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="13" height="16" rx="2"/><rect x="9" y="2" width="13" height="16" rx="2"/></svg>
          </div>
          <h3>Rękawy i organizery</h3>
          <p>Koszulki na karty w każdym rozmiarze oraz insert-y do pudełek.</p>
          <span class="go">Zobacz dział →</span>
        </a>
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12,3 20,7.5 20,16.5 12,21 4,16.5 4,7.5"/><path d="M8 13l3-4 2 3 3-3"/></svg>
          </div>
          <h3>Teren i sceneria</h3>
          <p>Modułowe płytki heksagonalne, ruiny 3D i elementy krajobrazu.</p>
          <span class="go">Zobacz dział →</span>
        </a>
        <a class="cat-card" href="#">
          <div class="cat-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21l4-1 10-10-3-3L4 17l-1 4z"/><path d="M14 7l3-3 3 3-3 3"/></svg>
          </div>
          <h3>Farby i narzędzia</h3>
          <p>Farby akrylowe, pędzle, kleje i podkłady do malowania figurek.</p>
          <span class="go">Zobacz dział →</span>
        </a>
      </div>
    </div>
  </section>

  <section id="bestsellery">
    <div class="wrap">
      <div class="cat-head">
        <div>
          <span class="eyebrow">Najczęściej wracają po więcej</span>
          <h2 class="section-title">Bestsellery</h2>
        </div>
      </div>

      <div class="prod-grid">
        <div class="prod-card">
          <div class="prod-media">
            <span class="prod-tag">Bestseller</span>
            <svg viewBox="0 0 100 100" fill="none"><polygon points="50,6 90,27 90,73 50,94 10,73 10,27" fill="#2c2418" stroke="#e2a53a" stroke-width="2.4"/><path d="M50 6V94M10 27L90 73M90 27L10 73" stroke="#e2a53a" stroke-width="1" opacity=".5"/></svg>
          </div>
          <div class="prod-body">
            <h4>Zestaw kości Ember Glass</h4>
            <p class="meta">7 kości, szkło hartowane, etui</p>
            <div class="prod-foot">
              <span class="price">59 zł</span>
              <button class="add-btn">Do koszyka</button>
            </div>
          </div>
        </div>

        <div class="prod-card">
          <div class="prod-media">
            <svg viewBox="0 0 100 100" fill="none"><polygon points="50,4 93,27 93,73 50,96 7,73 7,27" fill="#233d2c" stroke="#3f7d5c" stroke-width="2.4"/><path d="M28 60 Q50 28 72 60" stroke="#3f7d5c" stroke-width="2.6" fill="none"/></svg>
          </div>
          <div class="prod-body">
            <h4>Heksagonalne płytki terenu</h4>
            <p class="meta">24 płytki, 6 biomów, MDF 3mm</p>
            <div class="prod-foot">
              <span class="price">89 zł</span>
              <button class="add-btn">Do koszyka</button>
            </div>
          </div>
        </div>

        <div class="prod-card">
          <div class="prod-media">
            <span class="prod-tag">Nowość</span>
            <svg viewBox="0 0 100 100" fill="none"><path d="M50 8 C41 8 35 15 35 23 C35 29 38 33 42 35 L28 58 C25 65 28 72 35 74 L39 92 L61 92 L65 74 C72 72 75 65 72 58 L58 35 C62 33 65 29 65 23 C65 15 59 8 50 8 Z" fill="#c24a2a"/></svg>
          </div>
          <div class="prod-body">
            <h4>Deluxe zestaw pionków (32 szt.)</h4>
            <p class="meta">4 kolory, drewno bukowe</p>
            <div class="prod-foot">
              <span class="price">45 zł</span>
              <button class="add-btn">Do koszyka</button>
            </div>
          </div>
        </div>

        <div class="prod-card">
          <div class="prod-media">
            <svg viewBox="0 0 120 90" fill="none"><rect x="6" y="18" width="70" height="52" rx="6" fill="#241e17" stroke="#e2a53a" stroke-width="2"/><rect x="24" y="6" width="70" height="52" rx="6" fill="#2c2418" stroke="#f3c469" stroke-width="2"/></svg>
          </div>
          <div class="prod-body">
            <h4>Organizer na karty i rękawy</h4>
            <p class="meta">600 koszulek + skrzynka modułowa</p>
            <div class="prod-foot">
              <span class="price">39 zł</span>
              <button class="add-btn">Do koszyka</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="benefits">
    <div class="wrap benefit-grid">
      <div class="benefit">
        <div class="benefit-rule"></div>
        <h3>Wyselekcjonowane</h3>
        <p>Testujemy każdy produkt przy własnym stole, zanim trafi do sklepu — bierzemy tylko to, do czego sami wracamy.</p>
      </div>
      <div class="benefit">
        <div class="benefit-rule"></div>
        <h3>Trwałe materiały</h3>
        <p>Szkło, żywica, drewno i metal zamiast cienkiego plastiku — sprzęt, który zostaje w kolekcji na lata.</p>
      </div>
      <div class="benefit">
        <div class="benefit-rule"></div>
        <h3>Szybka wysyłka</h3>
        <p>Zamówienia pakujemy i wysyłamy w 24 godziny, kurierem na terenie całej Polski.</p>
      </div>
    </div>
  </section>

  <section class="quote-sec">
    <div class="wrap quote-wrap">
      <div class="quote-card">
        <span class="quote-mark" aria-hidden="true">"</span>
        <p class="text">Kości, które wyglądają jak relikwie, nie jak zabawki z automatu. Mój stolik do gier nigdy nie wyglądał lepiej.</p>
        <p class="who">Kasia — prowadzi kampanię D&amp;D od 6 lat</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap inner">
      <div>
        <h2>Bądź pierwszy przy nowych dropach</h2>
        <p>Raz w tygodniu, bez spamu — tylko nowości i restocki.</p>
      </div>
      <form class="cta-form" id="newsletter-form">
        <label for="newsletter-email" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Adres e-mail</label>
        <input id="newsletter-email" type="email" required placeholder="twoj@email.pl">
        <button type="submit">Zapisz się</button>
        <span class="form-note" id="newsletter-note"></span>
      </form>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="#top">
          <svg class="seal" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="19" fill="#1c1712" stroke="#e2a53a" stroke-width="1.4"/>
            <path d="M20 10 L27 14.5 V25.5 L20 30 L13 25.5 V14.5 Z" fill="none" stroke="#f3c469" stroke-width="1.3"/>
          </svg>
          <span class="brand-word">Loot Table</span>
        </a>
        <p>Sklep z elementami do gier planszowych — kości, miniaturki, pionki, teren i organizery, wybrane przez graczy dla graczy.</p>
      </div>
      <div class="footer-col">
        <h5>Sklep</h5>
        <ul>
          <li><a href="#kategorie">Kości i RNG</a></li>
          <li><a href="#kategorie">Miniaturki</a></li>
          <li><a href="#kategorie">Teren i sceneria</a></li>
          <li><a href="#bestsellery">Bestsellery</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>Obsługa</h5>
        <ul>
          <li><a href="#">Wysyłka i dostawa</a></li>
          <li><a href="#">Zwroty</a></li>
          <li><a href="#">Kontakt</a></li>
          <li><a href="#">FAQ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>Śledź nas</h5>
        <ul>
          <li><a href="#">Instagram</a></li>
          <li><a href="#">Discord</a></li>
          <li><a href="#">YouTube</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Loot Table. Wszystkie prawa zastrzeżone.</p>
      <div class="socials">
        <a class="icon-btn" href="#" aria-label="Instagram">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </a>
        <a class="icon-btn" href="#" aria-label="Discord">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="4"/><circle cx="9" cy="12" r="1.4" fill="currentColor"/><circle cx="15" cy="12" r="1.4" fill="currentColor"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('newsletter-form').addEventListener('submit', function(e){
    e.preventDefault();
    document.getElementById('newsletter-note').textContent = 'Dzięki! Sprawdź skrzynkę, żeby potwierdzić zapis.';
    this.reset();
  });

  var toggle = document.querySelector('.nav-toggle');
  var links = document.querySelector('nav.links');
  if(toggle){
    toggle.addEventListener('click', function(){
      var open = links.style.display === 'flex';
      links.style.display = open ? 'none' : 'flex';
      links.style.cssText += 'flex-direction:column; position:absolute; top:64px; right:28px; background:#1e1914; border:1px solid #35291c; border-radius:12px; padding:16px 22px; gap:14px;';
    });
  }
</script>

</body>
</html>
